# Agent Mesh 环境变量模板
#
# 使用:
#   cp .env.example .env
#   编辑 .env,填入实际密码(至少改三处 CHANGE_ME)
#   docker compose up -d

# === MySQL ===
# SECURITY: 生产部署必须改为强密码,建议 `openssl rand -base64 24`
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_USER=gateway
MYSQL_PASSWORD=CHANGE_ME_gateway
MYSQL_DATABASE=agent_gateway
MYSQL_PORT=3306

# === Redis ===
REDIS_PORT=6379

# === Gateway ===
# 对外暴露的端口,skill 默认连 11556
GATEWAY_PORT=11556

# === JWT ===
# SECURITY: 生产部署必须改为强随机,建议 `openssl rand -base64 32`
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
